# DevSwarm Environment Configuration

# Google Gemini API Key (Required for live LLM operations)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Models
DEVSWARM_DEFAULT_MODEL=gemini-2.5-flash
DEVSWARM_REASONING_MODEL=gemini-2.5-pro
DEVSWARM_FAST_MODEL=gemini-2.0-flash-lite

# Autonomy Mode: autonomous | semi_autonomous | supervised | strict_approval
DEVSWARM_AUTONOMY_MODE=semi_autonomous

# Storage Configuration
DEVSWARM_DATABASE_URL=sqlite+aiosqlite:///./devswarm.db

# Execution Sandbox
DEVSWARM_SANDBOX_BASE_DIR=./.devswarm/sandboxes
DEVSWARM_SANDBOX_TIMEOUT_SECONDS=120
DEVSWARM_SANDBOX_MAX_OUTPUT_BYTES=1048576

# Server Configuration
DEVSWARM_HOST=0.0.0.0
DEVSWARM_PORT=8000
DEVSWARM_LOG_LEVEL=INFO
