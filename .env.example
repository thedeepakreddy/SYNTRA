# SYNTRA Environment Configuration
# Full Name: Synchronized Intelligence for Autonomous Engineering
# Tagline: One Vision. Multiple AI Agents. Autonomous Engineering.

# Google Gemini API Key (Required for live LLM operations)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Models
SYNTRA_DEFAULT_MODEL=gemini-2.5-flash
SYNTRA_REASONING_MODEL=gemini-2.5-pro
SYNTRA_FAST_MODEL=gemini-2.0-flash-lite

# Autonomy Mode: autonomous | semi_autonomous | supervised | strict_approval
SYNTRA_AUTONOMY_MODE=semi_autonomous

# Storage Configuration (PostgreSQL in production, SQLite in local dev)
SYNTRA_DATABASE_URL=sqlite+aiosqlite:///./syntra.db

# Execution Sandbox
SYNTRA_SANDBOX_BASE_DIR=./.syntra/sandboxes
SYNTRA_SANDBOX_TIMEOUT_SECONDS=120
SYNTRA_SANDBOX_MAX_OUTPUT_BYTES=1048576

# Server Configuration
SYNTRA_HOST=0.0.0.0
SYNTRA_PORT=8000
SYNTRA_LOG_LEVEL=INFO
